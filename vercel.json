{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "_lib/**"
    }
  },
  "rewrites": [
    { "source": "/api/products/:id", "destination": "/api/products/[id]" },
    { "source": "/api/customers/:id", "destination": "/api/customers/[id]" },
    { "source": "/api/orders/:id", "destination": "/api/orders/[id]" },
    { "source": "/api/discounts/:id", "destination": "/api/discounts/[id]" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}